# LiveKit Cloud (Project Settings -> Keys)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase (Project Settings -> API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings -> Database -> Connection string, session pooler), used only to apply migrations
SUPABASE_DB_URL=
